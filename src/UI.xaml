<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#F7F8FA" Margin="0" TextElement.FontFamily="Microsoft YaHei UI" TextElement.FontSize="13" TextElement.Foreground="#252832">
 <Grid.Resources>
  <Style TargetType="Button">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="14,9"/><Setter Property="Foreground" Value="#424752"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E5E7EB"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" CornerRadius="9" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.84"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.65"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollViewer"><Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/><Setter Property="PanningMode" Value="VerticalOnly"/></Style>
 </Grid.Resources>
 <Grid>
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <Border Background="#F7F7F7" BorderBrush="#E2E2E2" BorderThickness="0,0,0,1" CornerRadius="20,20,0,0" Padding="14,6,14,6" Height="64" Margin="0,0,0,24">
 <Grid x:Name="WindowHeader" Background="Transparent" Focusable="True" FocusVisualStyle="{x:Null}">
  <Button x:Name="SettingsButton" ToolTip="设置快捷键" AutomationProperties.Name="设置" HorizontalAlignment="Left" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Width="48" Height="48" Padding="0">
   <Grid Width="24" Height="26"><Path Data="M 12,1 L 22,6.8 L 22,19.2 L 12,25 L 2,19.2 L 2,6.8 Z" Stroke="#666666" StrokeThickness="2.5" StrokeLineJoin="Round"/><Ellipse Width="8" Height="8" Stroke="#666666" StrokeThickness="2.5" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
  </Button>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
   <Button x:Name="MinimizeButton" ToolTip="最小化" AutomationProperties.Name="最小化" Background="Transparent" BorderThickness="0" Width="48" Height="48" Padding="0" Margin="0,0,12,0"><Rectangle Width="18" Height="3" Fill="#666666"/></Button>
   <Button x:Name="CloseButton" ToolTip="隐藏到系统托盘" AutomationProperties.Name="关闭并隐藏到系统托盘" Background="Transparent" BorderThickness="0" Width="48" Height="48" Padding="0"><Path Width="16" Height="16" Data="M 1,1 L 15,15 M 15,1 L 1,15" Stroke="#666666" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button>
  </StackPanel>
 </Grid>
 </Border>
 <Grid Grid.Row="2" Margin="28,0,28,16"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="选择窗口" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="WindowCount" Text="" Foreground="#757B86" Margin="14,4,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="ClearButton" Content="清空选择" Margin="0,0,10,0"/><Button x:Name="RefreshButton"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="刷新窗口"/></StackPanel></Button></StackPanel></Grid>
 <Grid Grid.Row="3" Margin="28,0,28,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
  <ScrollViewer x:Name="GalleryScroll"><WrapPanel x:Name="Gallery" Margin="0,0,4,0"/></ScrollViewer>
  <Border Grid.Column="2" CornerRadius="16" Background="White" BorderBrush="#E5E7ED" BorderThickness="1" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Text="切换顺序" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,18"/>
   <ScrollViewer Grid.Row="1"><StackPanel x:Name="Queue"/></ScrollViewer>
  </Grid></Border>
 </Grid>
 </Grid>
</Grid>
